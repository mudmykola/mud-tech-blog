{
  "name": "mini-blog",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "test": "node --test $(find tests -name \"*.test.js\" -print)",
    "build": "vite build",
    "bump:deploy-version": "node scripts/bump-deploy-version.mjs",
    "deploy": "npm run bump:deploy-version && npm run test && npm run build && npx firebase-tools deploy --only hosting",
    "preview": "vite preview",
    "format": "prettier --write ."
  },
  "dependencies": {
    "@mdi/font": "^7.4.47",
    "@vueuse/head": "^2.0.0",
    "axios": "^1.8.3",
    "firebase": "^11.4.0",
    "fuse.js": "^7.1.0",
    "pinia": "^3.0.1",
    "vite-imagetools": "^9.0.0",
    "vue": "^3.5.13",
    "vue-gtag": "^3.5.0",
    "vue-router": "^4.5.0",
    "vuetify": "^3.10.11"
  },
  "devDependencies": {
    "@fortawesome/fontawesome-svg-core": "^7.1.0",
    "@fortawesome/free-regular-svg-icons": "^7.1.0",
    "@fortawesome/free-solid-svg-icons": "^7.1.0",
    "@fortawesome/vue-fontawesome": "^3.1.2",
    "@mdi/js": "^7.4.47",
    "@vitejs/plugin-vue": "^6.0.0",
    "material-design-icons-iconfont": "^6.7.0",
    "prettier": "^3.6.2",
    "sass-embedded": "^1.85.1",
    "vite": "7.1.11",
    "vite-plugin-pwa": "^1.1.0"
  }
}
